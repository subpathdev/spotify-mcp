# Copy to .env for a local run (.env is git-ignored). In Kubernetes these come
# from the Helm values and a Secret instead.

# From your app in the Spotify developer dashboard (https://developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a redirect URI registered in the app exactly. Spotify accepts
# HTTPS, or http://127.0.0.1:<port>/callback for a local run.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Base URL for invite links. Default: the redirect URI without /callback.
#PUBLIC_URL=

# Where the token and invites are kept (owner-only files). Default /data.
DATA_DIR=./data

# Profile name of the account (lower-case letters, digits, dashes). Default "default".
#PROFILE=default

# MCP endpoint (Streamable HTTP at /mcp) and connect page. Defaults :8000 and :8080.
#MCP_ADDR=:8000
#WEB_ADDR=:8080
