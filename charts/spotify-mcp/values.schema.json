{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["config", "existingSecret"],
  "properties": {
    "config": {
      "type": "object",
      "required": ["redirectURI"],
      "properties": {
        "redirectURI": { "type": "string", "pattern": "^(https://.+|http://127\\.0\\.0\\.1(:[0-9]+)?)/callback$" },
        "publicURL": { "type": "string" },
        "profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" }
      }
    },
    "existingSecret": { "type": "string", "minLength": 1 }
  }
}
